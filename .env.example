# =============================================================================
# AP Data Analysis App — Environment Configuration
# =============================================================================
# Copy this file to `.env` and fill in real values before deploying.
# NEVER commit the real `.env` file to git (it is already in .gitignore).
# In production, prefer your platform's secret manager (Docker secrets,
# Streamlit Cloud "Secrets", AWS Parameter Store/Secrets Manager, etc.)
# over a plain .env file on disk.
# =============================================================================

# ---- Environment -----------------------------------------------------------
APP_ENV=development
# development | production

# ---- Session / crypto secret ------------------------------------------------
# Used as an internal integrity secret. Generate a strong random value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_VALUE

# ---- Bootstrap admin account -------------------------------------------------
# Used ONLY the very first time the app runs (when no user store exists yet).
# If BOOTSTRAP_ADMIN_PASSWORD is left blank, a random one-time password is
# generated and printed to the server console/log on first startup.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=

# ---- Third-party API keys ----------------------------------------------------
# Never hard-code this in source. Never print it. Never send it to the browser.
OPENAI_API_KEY=

# ---- Storage ------------------------------------------------------------------
APP_DATA_DIR=./data
USERS_JSON_PATH=auth/users.json

# ---- Login lockout policy ------------------------------------------------------
MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_WINDOW_MINUTES=15

# ---- Session policy --------------------------------------------------------------
IDLE_TIMEOUT_MINUTES=30
SESSION_AUTOREFRESH_MS=60000

# ---- Rate limiting ------------------------------------------------------------------
AI_INSIGHTS_RATE_LIMIT=10
AI_INSIGHTS_RATE_WINDOW_SECONDS=60

LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=60

ADMIN_ACTION_RATE_LIMIT=30
ADMIN_ACTION_RATE_WINDOW_SECONDS=60

# ---- Password policy -----------------------------------------------------------------
MIN_PASSWORD_LENGTH=8

# =============================================================================
# Secret rotation strategy (documented here so ops knows the procedure):
#
# 1. SESSION_SECRET / API keys: rotate quarterly or immediately on suspected
#    compromise. Update the env var in your secret manager, then restart the
#    app process — no code change required.
# 2. BOOTSTRAP_ADMIN_PASSWORD: only used once at first run; after that,
#    rotate the admin password via the in-app "Change Password" screen
#    (bcrypt-hashed, stored in auth/users.json / your user store), not via
#    this file.
# 3. OPENAI_API_KEY: rotate via the provider dashboard, update the env var,
#    restart. Keep the old key active for a short overlap window if the
#    provider supports multiple active keys, to avoid downtime.
# 4. Never reuse a rotated secret. Never log a secret value anywhere
#    (see security/audit.py's scrubber, which is a backstop, not a
#    substitute for not logging secrets in the first place).
# =============================================================================
